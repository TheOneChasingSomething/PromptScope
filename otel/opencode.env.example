# opencode telemetry -> local OTel Collector.
# Source this (or export the vars) in the shell where you launch opencode.

export OPENCODE_ENABLE_TELEMETRY=1

# Send to the collector's OTLP/HTTP receiver (NOT straight to Phoenix), so the
# redaction step runs first.
export OPENCODE_OTLP_ENDPOINT="http://localhost:4318"

# No auth for the local collector. If you later put the collector behind auth,
# set the header here (comma-separated key=value pairs).
export OPENCODE_OTLP_HEADERS=""
